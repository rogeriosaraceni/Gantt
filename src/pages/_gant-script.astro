    function renderLinhaQuickAdd(grupoId) {
        return `
            <tr class="quick-add-row" data-group-id="${grupoId}">
                <td class="text-center"></td>
                <td class="text-center text-secondary"></td>
                <td class="activity-cell">
                    <input
                        type="text"
                        class="quick-add-input"
                        data-group-id="${grupoId}"
                        placeholder="Nova tarefa... (Enter para salvar)"
                        style="width: 100%; border: none; border-bottom: 1px solid #ced4da; outline: none; background: transparent; padding: 2px 4px; font-size: 0.75rem;"
                    >
                </td>
