---
import Layout from "../../layouts/Layout.astro";
---

<style>
    body { background-color: #f8f9fa; }
    .text-desvio-atrasado { color: #dc3545; font-weight: 600; }
    .text-desvio-adiantado { color: #0d6efd; font-weight: 600; }
    .text-desvio-noprazo { color: #198754; font-weight: 600; }

    @media print {
        .no-print { display: none !important; }
        body { background-color: #ffffff !important; }
        .card-print {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            max-width: 100% !important;
        }
    }
</style>

<Layout>
    <!-- Barra Superior de Controle (Oculta ao imprimir) -->
    <div class="bg-dark text-white p-3 d-flex justify-content-between align-items-center no-print">
        <div class="d-flex align-items-center gap-2">
            <label for="selectBaseline" class="form-label mb-0 small fw-semibold text-nowrap">Linha de Base:</label>
            <select id="selectBaseline" class="form-select form-select-sm bg-secondary text-white border-0" style="min-width: 220px;">
                <!-- Preenchido via JavaScript -->
            </select>
        </div>
        <button type="button" class="btn btn-danger btn-sm px-3" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimir / Salvar PDF
        </button>
    </div>

    <!-- Relatório -->
    <div class="container my-4">
        <div class="bg-white p-4 rounded-3 shadow-sm card-print mx-auto" style="max-width: 900px;">
            <h4 class="fw-bold mb-1" id="compareProjectTitle">Comparativo de Linha de Base</h4>
            <p class="text-muted small mb-3" id="compareBaselineSub">Comparação com a Linha de base</p>

            <div id="compareImpactBanner" class="alert alert-success border-0 py-2 px-3 mb-3 fw-semibold">
                Impacto no prazo final do projeto: sem alteração
            </div>

            <div class="d-flex gap-4 mb-3 small fw-semibold">
                <span class="text-danger"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i><span id="cntAtrasadas">0</span> atrasada(s)</span>
                <span class="text-primary"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i><span id="cntAdiantadas">0</span> adiantada(s)</span>
                <span class="text-success"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i><span id="cntNoPrazo">0</span> no prazo</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th>Atividade</th>
                            <th class="text-center" id="thBaselineLabel">Linha de base</th>
                            <th class="text-center">Real (ou hoje)</th>
                            <th class="text-end">Desvio</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyCompareTasks">
                        <!-- Linhas da tabela inseridas via Script -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</Layout>

<script is:inline>
    function analisarData(texto) {
        if (!texto) return null;
        if (texto instanceof Date) return texto;
        const partes = String(texto).split("-").map(Number);
        if (partes.length < 3 || isNaN(partes[0])) return null;
        return new Date(partes[0], partes[1] - 1, partes[2]);
    }

    function paraISO(objetoData) {
        if (!objetoData) return "";
        const ano = objetoData.getFullYear();
        const mes = String(objetoData.getMonth() + 1).padStart(2, "0");
        const dia = String(objetoData.getDate()).padStart(2, "0");
        return `${ano}-${mes}-${dia}`;
    }

    function formatarDataBR(textoISO) {
        if (!textoISO) return "";
        if (textoISO instanceof Date) {
            const d = String(textoISO.getDate()).padStart(2, '0');
            const m = String(textoISO.getMonth() + 1).padStart(2, '0');
            const a = textoISO.getFullYear();
            return `${d}/${m}/${a}`;
        }
        const partes = String(textoISO).split("-");
        if (partes.length < 3) return textoISO;
        return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }

    function diferencaDias(dataInicial, dataFinal) {
        if (!dataInicial || !dataFinal) return 0;
        const msPorDia = 86400000;
        return Math.round((dataFinal - dataInicial) / msPorDia);
    }

    function escaparHtml(valor) {
        return String(valor ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    $(document).ready(function () {
        let dadosPai = window.parent?.dadosComparacaoGantt || window.opener?.dadosComparacaoGantt || window.dadosComparacaoGantt;

        if (!dadosPai) {
            try {
                const stored = sessionStorage.getItem("dadosComparacaoGantt");
                if (stored) dadosPai = JSON.parse(stored);
            } catch (e) {}
        }

        if (!dadosPai) {
            console.warn("Nenhum dado de comparação foi fornecido via window.dadosComparacaoGantt");
            $("#compareBaselineSub").text("Nenhuma linha de base disponível para comparação. Abra o Gantt e salve uma linha de base primeiro.");
            $("#compareImpactBanner").removeClass("alert-success").addClass("alert-warning").text("Aguardando dados do projeto...");
            $("#tbodyCompareTasks").html(`
                <tr>
                    <td colspan="4" class="text-center text-muted py-3">
                        Nenhuma atividade para comparar. Salve uma linha de base no Gantt.
                    </td>
                </tr>
            `);
            return;
        }

        // Define o Título do Projeto
        if (dadosPai.titulo) {
            $("#compareProjectTitle").text(dadosPai.titulo);
        }

        // Garante que baselines seja uma lista contendo todas as versões salvas
        let baselines = [];
        if (Array.isArray(dadosPai.baselines) && dadosPai.baselines.length > 0) {
            baselines = dadosPai.baselines;
        } else {
            baselines = [{
                versao: dadosPai.versao || "1",
                data: dadosPai.dataSalva || new Date().toLocaleDateString('pt-BR'),
                tasks: dadosPai.tasks || dadosPai.linhas || []
            }];
        }

        // 1. Popula o Select no padrão: "Linha de base X — DD/MM/AAAA"
        const $select = $("#selectBaseline").empty();
        baselines.forEach((b, index) => {
            const numVersao = b.versao !== undefined ? b.versao : (index + 1);
            const dataStr = b.data ? ` — ${b.data}` : "";
            const optionText = `Linha de base ${numVersao}${dataStr}`;

            $select.append(`<option value="${index}">${escaparHtml(optionText)}</option>`);
        });

        // Seleciona por padrão a versão mais recente
        const ultimoIndice = baselines.length - 1;
        $select.val(ultimoIndice);

        // 2. Renderiza o Relatório
        function renderizarRelatorio(idxVersao) {
            const baselineInfo = baselines[idxVersao];
            if (!baselineInfo) return;

            const listaTarefasBase = baselineInfo.tasks || [];
            const tasksAtuais = Array.isArray(dadosPai.tasksAtuais) && dadosPai.tasksAtuais.length > 0
                ? dadosPai.tasksAtuais
                : listaTarefasBase;

            const numVersao = baselineInfo.versao !== undefined ? baselineInfo.versao : (idxVersao + 1);
            const dataStr = baselineInfo.data ? ` — salva em ${baselineInfo.data}` : "";

            $("#compareBaselineSub").text(`Comparação com a Linha de Base ${numVersao}${dataStr}`);
            $("#thBaselineLabel").text(`Linha de base ${numVersao}`);

            let totalAtrasadas = 0, totalAdiantadas = 0, totalNoPrazo = 0;
            let maiorAtrasoFim = 0;
            let fimMaxBaseDate = null;
            let fimMaxAtualDate = null;

            const $tbody = $("#tbodyCompareTasks").empty();
            const hoje = new Date();
            hoje.setHours(0, 0, 0, 0);
            const hojeISO = paraISO(hoje);

            function temFilhos(t, lista) {
                return lista.some((item) => item.parentId === t.id);
            }

            function filhasDoGrupo(grupo, lista) {
                const filhas = [];
                const visitar = (pai) => {
                    const diretos = lista.filter((t) => t.parentId === pai.id);
                    diretos.forEach((filho) => {
                        const temSub = lista.some((t) => t.parentId === filho.id);
                        if (!temSub) {
                            filhas.push(filho);
                        } else {
                            visitar(filho);
                        }
                    });
                };
                visitar(grupo);
                return filhas;
            }

            function nivelDaTarefa(tarefa, lista) {
                let nivel = 0;
                let atual = tarefa;
                const vistos = new Set();
                while (atual?.parentId !== null && atual?.parentId !== undefined) {
                    if (vistos.has(atual.id)) break;
                    vistos.add(atual.id);
                    atual = lista.find((item) => item.id === atual.parentId);
                    if (!atual) break;
                    nivel++;
                }
                return nivel;
            }

            if (tasksAtuais.length === 0) {
                $tbody.append(`
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">
                            Nenhuma atividade encontrada no projeto.
                        </td>
                    </tr>
                `);
                return;
            }

            tasksAtuais.forEach((tarefa) => {
                const isGroupWithChildren = tarefa.group && temFilhos(tarefa, tasksAtuais);
                const nivel = nivelDaTarefa(tarefa, tasksAtuais);
                const nomeTarefa = tarefa.nome || `${tarefa.no ? tarefa.no + ' ' : ''}${tarefa.name || ''}`;

                // Se for grupo/fase com tarefas subordinadas: exibe linha de agrupamento com resumo consolidado
                if (isGroupWithChildren) {
                    const filhas = filhasDoGrupo(tarefa, tasksAtuais);

                    const basesFilhas = filhas.map((f) => {
                        const fBase = listaTarefasBase.find((tb) => tb.id === f.id) || f;
                        return fBase.baseline || fBase.planned || [];
                    });
                    const baseInicios = basesFilhas.map((b) => b[0]).filter(Boolean).sort();
                    const baseFins = basesFilhas.map((b) => b[1]).filter(Boolean).sort();
                    const grpBaseIni = baseInicios[0] || "";
                    const grpBaseFim = baseFins[baseFins.length - 1] || "";

                    const realInicios = filhas.map((f) => f.real?.[0] || f.planned?.[0]).filter(Boolean).sort();
                    const realFins = filhas.map((f) => {
                        const conc = (Number(f.progress) || 0) >= 100 || !!f.real?.[1];
                        return conc ? (f.real?.[1] || f.planned?.[1] || "") : hojeISO;
                    }).filter(Boolean).sort();
                    const grpRealIni = realInicios[0] || "";
                    const grpRealFim = realFins[realFins.length - 1] || "";

                    let grpDesvioTexto = "No prazo";
                    let grpClasseDesvio = "text-desvio-noprazo";
                    if (grpBaseFim && grpRealFim) {
                        const dBase = analisarData(grpBaseFim);
                        const dReal = analisarData(grpRealFim);
                        if (dBase && dReal) {
                            const grpDiff = diferencaDias(dBase, dReal);
                            if (grpDiff > 0) {
                                grpDesvioTexto = `+${grpDiff} dia(s)`;
                                grpClasseDesvio = "text-desvio-atrasado";
                            } else if (grpDiff < 0) {
                                grpDesvioTexto = `${grpDiff} dia(s)`;
                                grpClasseDesvio = "text-desvio-adiantado";
                            }
                        }
                    }

                    const grpBaseStr = (grpBaseIni && grpBaseFim)
                        ? `${formatarDataBR(grpBaseIni)} — ${formatarDataBR(grpBaseFim)}`
                        : "—";
                    const grpRealStr = (grpRealIni && grpRealFim)
                        ? `${formatarDataBR(grpRealIni)} — ${formatarDataBR(grpRealFim)}`
                        : "—";

                    $tbody.append(`
                        <tr class="table-light fw-bold">
                            <td class="py-2" style="padding-left: ${nivel * 20 + 8}px;">
                                <i class="bi bi-folder2-open text-primary me-1"></i>
                                ${escaparHtml(nomeTarefa)}
                            </td>
                            <td class="text-center text-muted py-2">${escaparHtml(grpBaseStr)}</td>
                            <td class="text-center py-2">${escaparHtml(grpRealStr)}</td>
                            <td class="text-end ${grpClasseDesvio} py-2">${escaparHtml(grpDesvioTexto)}</td>
                        </tr>
                    `);
                    return;
                }

                // Tarefa/atividade individual (folha)
                const tarefaBase = listaTarefasBase.find((tb) => tb.id === tarefa.id) || tarefa;
                const dtBaseIni = tarefaBase.baseline?.[0] || tarefaBase.planned?.[0] || tarefa.baseline?.[0] || tarefa.planned?.[0] || "";
                const dtBaseFim = tarefaBase.baseline?.[1] || tarefaBase.planned?.[1] || tarefa.baseline?.[1] || tarefa.planned?.[1] || "";

                if (dtBaseFim) {
                    const dFimB = analisarData(dtBaseFim);
                    if (dFimB && (!fimMaxBaseDate || dFimB > fimMaxBaseDate)) fimMaxBaseDate = dFimB;
                }

                const concluida = (Number(tarefa.progress) || 0) >= 100 || !!tarefa.real?.[1];

                let dtRealIni = tarefa.real?.[0] || tarefa.planned?.[0] || dtBaseIni || "";
                let dtRealFim = "";
                let realRangeStr = "—";
                let desvioTexto = "No prazo";
                let classeDesvio = "text-desvio-noprazo";
                let diffDias = 0;

                const dBaseFim = analisarData(dtBaseFim);

                if (concluida) {
                    dtRealFim = tarefa.real?.[1] || tarefa.planned?.[1] || dtBaseFim || "";
                    const dRealFim = analisarData(dtRealFim);

                    if (dRealFim && (!fimMaxAtualDate || dRealFim > fimMaxAtualDate)) {
                        fimMaxAtualDate = dRealFim;
                    }

                    if (dtRealIni && dtRealFim) {
                        realRangeStr = `${formatarDataBR(dtRealIni)} — ${formatarDataBR(dtRealFim)}`;
                    } else if (dtRealFim) {
                        realRangeStr = formatarDataBR(dtRealFim);
                    }

                    if (dBaseFim && dRealFim) {
                        diffDias = diferencaDias(dBaseFim, dRealFim);
                        if (diffDias > 0) {
                            desvioTexto = `+${diffDias} dia(s)`;
                            classeDesvio = "text-desvio-atrasado";
                            totalAtrasadas++;
                            if (diffDias > maiorAtrasoFim) maiorAtrasoFim = diffDias;
                        } else if (diffDias < 0) {
                            desvioTexto = `${diffDias} dia(s)`;
                            classeDesvio = "text-desvio-adiantado";
                            totalAdiantadas++;
                        } else {
                            totalNoPrazo++;
                        }
                    } else {
                        totalNoPrazo++;
                    }
                } else {
                    // SE AINDA NÃO CONCLUÍDA: a data de referência é HOJE
                    dtRealFim = hojeISO;
                    const dRealFim = analisarData(dtRealFim);

                    if (dRealFim && (!fimMaxAtualDate || dRealFim > fimMaxAtualDate)) {
                        fimMaxAtualDate = dRealFim;
                    }

                    const dRealIni = analisarData(dtRealIni);
                    if (dRealIni && hoje >= dRealIni) {
                        realRangeStr = `${formatarDataBR(dtRealIni)} — ${formatarDataBR(hojeISO)} (hoje)`;
                    } else if (dRealIni && hoje < dRealIni) {
                        const planFim = tarefa.planned?.[1] || dtBaseFim;
                        realRangeStr = planFim ? `${formatarDataBR(dtRealIni)} — ${formatarDataBR(planFim)} (previsto)` : "Não iniciada";
                    } else {
                        realRangeStr = `${formatarDataBR(hojeISO)} (hoje)`;
                    }

                    if (dBaseFim) {
                        if (hoje > dBaseFim) {
                            // Prazo da linha de base expirou sem conclusão
                            diffDias = diferencaDias(dBaseFim, hoje);
                            desvioTexto = `+${diffDias} dia(s)`;
                            classeDesvio = "text-desvio-atrasado";
                            totalAtrasadas++;
                            if (diffDias > maiorAtrasoFim) maiorAtrasoFim = diffDias;
                        } else if (tarefa.planned?.[1] && analisarData(tarefa.planned[1]) > dBaseFim) {
                            // Planejado atual ultrapassa a linha de base
                            diffDias = diferencaDias(dBaseFim, analisarData(tarefa.planned[1]));
                            desvioTexto = `+${diffDias} dia(s)`;
                            classeDesvio = "text-desvio-atrasado";
                            totalAtrasadas++;
                            if (diffDias > maiorAtrasoFim) maiorAtrasoFim = diffDias;
                        } else {
                            diffDias = 0;
                            desvioTexto = "No prazo";
                            classeDesvio = "text-desvio-noprazo";
                            totalNoPrazo++;
                        }
                    } else {
                        desvioTexto = "No prazo";
                        classeDesvio = "text-desvio-noprazo";
                        totalNoPrazo++;
                    }
                }

                const baseRangeStr = (dtBaseIni && dtBaseFim)
                    ? `${formatarDataBR(dtBaseIni)} — ${formatarDataBR(dtBaseFim)}`
                    : (tarefaBase.baseRange || "—");

                const recuoPx = nivel * 20 + 8;
                const iconeNivel = nivel > 0 ? '<i class="bi bi-arrow-return-right text-muted small me-1"></i>' : '';

                $tbody.append(`
                    <tr>
                        <td class="fw-medium" style="padding-left: ${recuoPx}px;">
                            ${iconeNivel}${escaparHtml(nomeTarefa)}
                        </td>
                        <td class="text-center text-muted">${escaparHtml(baseRangeStr)}</td>
                        <td class="text-center">${escaparHtml(realRangeStr)}</td>
                        <td class="text-end ${classeDesvio}">${escaparHtml(desvioTexto)}</td>
                    </tr>
                `);
            });

            // Atualiza Contadores
            $("#cntAtrasadas").text(totalAtrasadas);
            $("#cntAdiantadas").text(totalAdiantadas);
            $("#cntNoPrazo").text(totalNoPrazo);

            // Atualiza Banner de Impacto
            const $banner = $("#compareImpactBanner");
            let impactoDias = 0;
            if (fimMaxBaseDate && fimMaxAtualDate) {
                impactoDias = diferencaDias(fimMaxBaseDate, fimMaxAtualDate);
            } else {
                impactoDias = maiorAtrasoFim;
            }

            if (impactoDias > 0) {
                $banner.removeClass("alert-success alert-info").addClass("alert-danger")
                       .text(`Impacto no prazo final do projeto: atraso de ${impactoDias} dia(s)`);
            } else if (maiorAtrasoFim > 0) {
                $banner.removeClass("alert-success alert-info").addClass("alert-danger")
                       .text(`Impacto no prazo final do projeto: atividades atrasadas em até ${maiorAtrasoFim} dia(s)`);
            } else if (impactoDias < 0 && totalAtrasadas === 0) {
                $banner.removeClass("alert-success alert-danger").addClass("alert-info")
                       .text(`Impacto no prazo final do projeto: adiantado em ${Math.abs(impactoDias)} dia(s) em relação à linha de base`);
            } else if (totalAdiantadas > 0 && totalAtrasadas === 0) {
                $banner.removeClass("alert-success alert-danger").addClass("alert-info")
                       .text(`Impacto no prazo final do projeto: adiantado em relação à linha de base`);
            } else {
                $banner.removeClass("alert-danger alert-info").addClass("alert-success")
                       .text(`Impacto no prazo final do projeto: sem alteração`);
            }
        }

        // Listener para Troca de Linha de Base no Select
        $select.on("change", function () {
            renderizarRelatorio(Number($(this).val()));
        });

        // Renderização Inicial
        renderizarRelatorio(ultimoIndice);
    });
</script>
