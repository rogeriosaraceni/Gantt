<div class="d-flex justify-content-between align-items-center flex-wrap gantt-toolbar mb-2">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <button type="button" class="btn btn-dark" style="font-size: 0.9rem;" data-gantt-btn="addAtividade">
            <i class="bi bi-plus-lg me-1"></i>Incluir Nova Atividade
        </button>

        <div class="legend d-flex gap-3 flex-wrap">
            <div class="legend-item">
                <i class="legend-dot legend-baseline"></i>
                <span>Linha de base</span>
            </div>
            <div class="legend-item">
                <i class="legend-dot legend-real"></i>
                <span>Real</span>
            </div>
            <div class="legend-item">
                <i class="bi bi-fire status-overdue"></i>
                <i class="legend-dot legend-atrasado"></i>
                <span>Real Atrasado</span>
            </div>
            <div class="legend-item">
                <i class="bi bi-exclamation-triangle-fill status-critical"></i>
                <i class="legend-dot legend-critico"></i>
                <span>Caminho Crítico</span>
            </div>
            <!--
            <div class="legend-item">
                <i class="bi bi-stop-circle-fill legend-blocked"></i>
                <span>Impedimento</span>
            </div>
            <div class="legend-item">
                <i class="bi bi-exclamation-circle-fill legend-risk"></i>
                <span>Risco</span>
            </div>
            -->
            <div class="legend-item">
                <i class="legend-line legend-hoje"></i>
                <span>Hoje</span>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-funnel me-1"></i>Colunas
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2 column-menu">
                <div class="form-check">
                    <input class="form-check-input column-toggle" type="checkbox" value="owner" id="colOwner" checked />
                    <label class="form-check-label" for="colOwner">Responsável</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input column-toggle" type="checkbox" value="planned" id="colPlanned" checked />
                    <label class="form-check-label" for="colPlanned">Planejado</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input column-toggle" type="checkbox" value="real" id="colReal" checked />
                    <label class="form-check-label" for="colReal">Real</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input column-toggle" type="checkbox" value="predecessors" id="colPred" checked />
                    <label class="form-check-label" for="colPred">Predecessoras</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input column-toggle" type="checkbox" value="progress" id="colProgress" checked />
                    <label class="form-check-label" for="colProgress">%</label>
                </div>
                <hr class="my-2" />
                <button type="button" class="btn btn-light w-100" data-bs-toggle="dropdown">Fechar</button>
            </div>
        </div>

        <button type="button" class="btn btn-outline-secondary" data-gantt-btn="compare">
            <i class="bi bi-arrow-up-right me-1"></i>Comparar linha de base
        </button>

        <button type="button" class="btn btn-light" data-gantt-btn="saveBeseline">
            <i class="bi bi-shield-check me-1"></i>Salvar linha de base
        </button>

        <button
            type="button"
            class="btn btn-outline-secondary"
            data-bs-toggle="tooltip"
            data-bs-title="Mover para um nível superior (ex.: atividade → fase)"
            data-gantt-btn-nivel="superior"
        >
            <i class="bi bi-chevron-up"></i>
        </button>

        <button
            type="button"
            class="btn btn-outline-secondary"
            data-bs-toggle="tooltip"
            data-bs-title="Mover para um nível inferior (ex.: fase → atividade)"
            data-gantt-btn-nivel="Inferior"
        >
            <i class="bi bi-chevron-down"></i>
        </button>

        <div class="btn-group view-switch" role="group" aria-label="Escala">
            <button type="button" class="btn btn-sm" data-scale="week">Semana</button>
            <button type="button" class="btn active" data-scale="month">Mês</button>
            <button type="button" class="btn btn-sm" data-scale="year">Ano</button>
        </div>
    </div>
</div>
