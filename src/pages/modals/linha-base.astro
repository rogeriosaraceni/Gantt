<!-- Modal Histórico / Salvar Linha de Base -->
<div class="modal fade" id="modalBaseline" tabindex="-1" aria-labelledby="modalBaselineLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalBaselineLabel">Linhas de Base Salvas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">A nova linha de base foi registrada:</p>
                <ul id="listaBaselines" class="list-group">
                    <!-- As linhas salvas aparecerão aqui -->
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-modal-confirm" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>
